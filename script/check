#!/usr/bin/env bash
# Single local entry point for every check this project claims to pass.
#
# Usage: bash script/check [--fast] [--no-system] [--no-qunit]
#   --fast        static checks only (lint, RuboCop, OpenSpec, whitespace)
#   --no-system   skip the Chromium system specs
#   --no-qunit    skip the browser QUnit suite
#
# Postgres (55432) and Redis (56379) from docs/development/local-tests.md must
# be running for the Plugin specs. Nothing here talks to a real Nextcloud.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

fast=0
system=1
qunit=1
for arg in "$@"; do
  case "$arg" in
    --fast) fast=1 ;;
    --no-system) system=0 ;;
    --no-qunit) qunit=0 ;;
    -h | --help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 2
      ;;
  esac
done

step() { printf '\n== %s ==\n' "$1"; }

run() {
  local label="$1"
  shift
  if ! "$@"; then
    printf '\nFAILED: %s\n' "$label" >&2
    exit 1
  fi
}

step "JavaScript/CSS/TypeScript lint"
run "pnpm lint" npx --yes pnpm@12.11.2 lint

step "RuboCop"
run "rubocop" env BUNDLE_GEMFILE="$ROOT/Gemfile" BUNDLE_PATH="$ROOT/.local/bundle" \
  PATH="/opt/homebrew/opt/ruby@3.4/bin:$ROOT/.local/gems/bin:$PATH" \
  .local/gems/bin/bundle exec rubocop plugin.rb lib config spec app

step "OpenSpec validation"
run "openspec validate" npx --yes @fission-ai/openspec@1.15.0 validate --all --strict --no-interactive

step "Whitespace"
# Only tracked files: an untracked tree passes this check trivially, which the
# docs state explicitly instead of implying a content review.
run "git diff --check" git diff --check

if [[ $fast -eq 1 ]]; then
  printf '\nFast checks finished.\n'
  exit 0
fi

step "Plugin assets"
run "build plugin assets" env OFFICE_TEST_PLUGIN=1 \
  bash script/local-core bin/rake assets:precompile:build_plugins

step "Plugin specs (without system specs)"
run "plugin specs" env OFFICE_TEST_PLUGIN=1 bash script/local-core bin/rspec \
  plugins/discourse-nextcloud-office/spec \
  --exclude-pattern "**/spec/system/**/*_spec.rb" --format progress

if [[ $system -eq 1 ]]; then
  step "Plugin system specs (Chromium)"
  run "system specs" env OFFICE_TEST_PLUGIN=1 \
    bash script/local-core bin/rspec plugins/discourse-nextcloud-office/spec/system --format progress
fi

if [[ $qunit -eq 1 ]]; then
  step "Plugin QUnit"
  run "qunit" env OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES TEST_SERVER_PORT=56381 OFFICE_TEST_PLUGIN=1 \
    bash script/local-core bin/qunit --standalone --target discourse-nextcloud-office --parallel 1
fi

printf '\nAll requested checks finished.\n'
