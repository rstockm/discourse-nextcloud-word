#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CORE="$ROOT/.local/discourse"
EXPECTED_CORE="adf7244270b88a5485b32c7e815217e35c68b4e4"

if [[ $# -eq 0 ]]; then
  echo "Usage: bash script/local-core <core command> [arguments...]" >&2
  exit 2
fi

if [[ ! -d "$CORE/.git" ]] || [[ "$(git -C "$CORE" rev-parse HEAD)" != "$EXPECTED_CORE" ]]; then
  echo "The isolated Discourse checkout is missing or does not match the pinned baseline." >&2
  exit 1
fi

# Never inherit production connection settings or Core's parallel Redis launcher.
unset TEST_ENV_NUMBER DATABASE_URL PGDATABASE PGSERVICE PGSERVICEFILE PGPASSWORD PGOPTIONS
export PATH="$ROOT/script/dev-bin:/opt/homebrew/opt/ruby@3.4/bin:/opt/homebrew/opt/postgresql@17/bin:$ROOT/.local/gems/bin:$PATH"
export GEM_HOME="$ROOT/.local/gems"
export GEM_PATH="$GEM_HOME"
export BUNDLE_PATH="$ROOT/.local/bundle"
export RAILS_ENV=test
export RACK_ENV=test
export RAILS_DB=office_integration_test
export PGHOST=127.0.0.1
export PGPORT=55432
export PGUSER=office_test
export DISCOURSE_REDIS_PORT=56379
export SKIP_MULTISITE=1
# Core only supports plugin specs with LOAD_PLUGINS=1 (suite setup resets
# plugin registry otherwise and aborts). Core's bundled plugins therefore load
# as well, exactly like the upstream plugin CI. Until 1.3 is verified, the
# default stays LOAD_PLUGINS=0 for the plain core baseline.
case "${OFFICE_TEST_PLUGIN:-0}" in
  0) export LOAD_PLUGINS=0 ;;
  1) export LOAD_PLUGINS=1 ;;
  *) echo "OFFICE_TEST_PLUGIN must be 0 or 1." >&2; exit 2 ;;
esac
export PLAYWRIGHT_BROWSERS_PATH="$CORE/tmp/playwright-browsers"
export CAPYBARA_SERVER_HOST=127.0.0.1
export CAPYBARA_SERVER_PORT=56380
export PLAYWRIGHT_HEADLESS=1
export DISCOURSE_DOWNLOAD_PRE_BUILT_ASSETS=0

cd "$CORE"
exec "$@"
